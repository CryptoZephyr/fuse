{
  "name": "fuse-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Fuse — Builder codes and distribution router for Mezo (Track 2)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CryptoZephyr/fuse.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:test:fork": "forge test --root contracts --match-path test/FuseRouter.fork.t.sol --fork-url https://rpc.test.mezo.org -vv",
    "contracts:fmt": "forge fmt --root contracts --check",
    "build": "pnpm --filter @fuse/sdk build && pnpm --filter @fuse/web build",
    "test:packages": "pnpm --recursive --if-present test",
    "test": "pnpm contracts:test && pnpm test:packages",
    "typecheck": "pnpm --filter @fuse/sdk build && pnpm --recursive --if-present typecheck"
  }
}
